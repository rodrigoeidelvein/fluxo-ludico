---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProofBar from '../components/ProofBar.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Team from '../components/Team.astro';
import Instagram from '../components/Instagram.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBar from '../components/WhatsAppBar.astro';
import Lightbox from '../components/Lightbox.astro';
---

<Base>
  <Header />
  <!-- A ordem das seções é o funil e não deve ser alterada (ver handoff). -->
  <Hero />
  <ProofBar />
  <Services />
  <Gallery />
  <Testimonials />
  <Team />
  <Instagram />
  <QuoteForm />
  <Footer />
  <WhatsAppBar />
  <Lightbox />
</Base>
