---
import { services } from '../data/content';
---

<section id="servicos" class="page-x pt-[26px] pb-[6px] lg:pt-20">
  <h2 class="eyebrow mb-[14px] text-accent lg:mb-6">01 — Serviços</h2>

  <div class="flex flex-col gap-[10px] lg:grid lg:grid-cols-[1fr_1.6fr] lg:gap-4">
    <article
      class="relative overflow-hidden rounded-card bg-coral p-5 text-paper lg:flex lg:flex-col lg:justify-end lg:p-9 transition-transform duration-150 ease-out hover:-translate-y-0.5"
    >
      <div
        class="absolute -top-6 -right-6 size-24 rounded-full lg:-top-12 lg:-right-12 lg:size-56 bg-paper/16"
        aria-hidden="true"
      >
      </div>
      <h3 class="font-display text-poster tracking-[-0.03em] uppercase lg:text-[52px]">Recreação</h3>
      <p class="mt-[9px] max-w-[30ch] text-[13px]/[1.45] font-medium lg:mt-4 lg:text-[16px]/[1.45]">
        2 a 4 recreadores, brincadeiras separadas por idade, do começo ao fim da festa.
      </p>
    </article>

    <div class="grid grid-cols-2 gap-[10px] lg:gap-4">
      {
        services.map((service) => (
          <article
            class:list={[
              'rounded-card p-4 transition-transform lg:min-h-[180px] lg:p-7 duration-150 ease-out hover:-translate-y-0.5',
              service.className,
            ]}
          >
            <h3 class="font-display text-[18px]/[1] tracking-[-0.02em] uppercase lg:text-[28px]/[1]">
              <Fragment set:html={service.title} />
            </h3>
            <p class="mt-2 text-[12px]/[1.4] font-medium lg:mt-3 lg:text-[15px]/[1.45]">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
