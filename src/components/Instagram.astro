---
import Photo from './Photo.astro';
import { instagramPosts } from '../data/content';
import { instagramUrl } from '../lib/site';
---

<section class="pb-[26px] lg:py-20">
  <div class="mb-[10px] flex items-baseline justify-between lg:mb-6">
    <h2 class="font-display text-[18px] tracking-[-0.02em]">@fluxoludico</h2>
    <a
      href={instagramUrl}
      target="_blank"
      rel="noopener"
      class="font-mono text-[11px] font-medium text-accent uppercase">Seguir</a
    >
  </div>

  <ul class="grid grid-cols-3 gap-[5px] lg:gap-3">
    {
      instagramPosts.map((post) => (
        <li>
          <a href={instagramUrl} target="_blank" rel="noopener">
            <Photo
              alt={post.alt}
              tint={post.tint}
              src={post.src}
              sizes="(min-width: 1024px) 180px, 33vw"
              class="aspect-[4/5] rounded-control"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>
