---
import { testimonials } from '../data/content';
---

<section class="mt-6 bg-ink px-[18px] py-[28px] text-paper">
  <h2 class="eyebrow mb-4 text-yellow">03 — Relatos</h2>

  <div class="flex flex-col gap-[10px]">
    {
      testimonials.map((item) => (
        <blockquote class="rounded-card bg-surface-dark p-[18px]">
          <p class="text-[14px]/[1.5] font-medium">&ldquo;{item.quote}&rdquo;</p>
          <footer class="mt-[13px] flex items-center gap-[9px]">
            <span
              class:list={['block size-7 rounded-full', item.avatarClass]}
              aria-hidden="true"
            />
            <span class="font-mono text-[11px] font-medium text-muted-on-dark uppercase">
              {item.author}
            </span>
          </footer>
        </blockquote>
      ))
    }
  </div>
</section>
