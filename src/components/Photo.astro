---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { Tint } from '../data/content';

/**
 * Foto otimizada (quando `src` é passado) ou placeholder hachurado. O wrapper
 * mantém o aspect-ratio ou a altura fixa, o que evita layout shift nos dois
 * casos. `data-caption` alimenta a legenda do lightbox.
 */
interface Props {
  alt: string;
  tint: Tint;
  src?: ImageMetadata;
  /** Atributo `sizes` do <img>; ajuste à largura real em que a foto aparece. */
  sizes?: string;
  /** `contain` mostra o post inteiro (lightbox); `cover` recorta para preencher. */
  fit?: 'cover' | 'contain';
  /** Legenda em mono no canto inferior do placeholder, como no protótipo. */
  caption?: string;
  class?: string;
}

const {
  alt,
  tint,
  src,
  sizes = '100vw',
  fit = 'cover',
  caption,
  class: className = '',
} = Astro.props;

const tintClass: Record<Tint, string> = {
  'tint-yellow': 'bg-tint-yellow',
  'tint-sand': 'bg-tint-sand',
  'tint-coral': 'bg-tint-coral',
  'tint-blue': 'bg-tint-blue',
  'tint-green': 'bg-tint-green',
};
---

{
  src ? (
    <div data-caption={alt} class:list={['relative overflow-hidden', className]}>
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[320, 640, 1024]}
        sizes={sizes}
        class:list={[
          'absolute inset-0 h-full w-full',
          fit === 'contain' ? 'object-contain' : 'object-cover',
        ]}
      />
    </div>
  ) : (
    <div
      role="img"
      aria-label={alt}
      data-caption={alt}
      class:list={['hatched flex items-end p-2', tintClass[tint], className]}
    >
      {caption && (
        <span class="font-mono text-[9px] font-medium tracking-[0.04em] uppercase opacity-60">
          {caption}
        </span>
      )}
    </div>
  )
}
