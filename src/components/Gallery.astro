---
import Photo from './Photo.astro';
import { gallery } from '../data/content';

const [main, ...rest] = gallery;
---

<section id="galeria" class="px-[18px] pt-[26px] pb-[6px]">
  <h2 class="eyebrow mb-[14px] text-accent">02 — Galeria</h2>

  <div class="grid grid-cols-[2fr_1fr] gap-[7px]" data-gallery>
    <button
      type="button"
      class="contents"
      data-gallery-item="0"
      aria-label={`Abrir foto: ${main.alt}`}
    >
      <Photo
        alt={main.alt}
        tint={main.tint}
        caption="foto principal"
        class="h-[190px] rounded-media"
      />
    </button>

    <div class="flex flex-col gap-[7px]">
      {
        rest.slice(0, 2).map((photo, i) => (
          <button
            type="button"
            class="flex flex-1"
            data-gallery-item={i + 1}
            aria-label={`Abrir foto: ${photo.alt}`}
          >
            <Photo alt={photo.alt} tint={photo.tint} class="h-full w-full rounded-media" />
          </button>
        ))
      }
    </div>
  </div>

  <button
    type="button"
    data-gallery-item="0"
    class="mt-3 inline-block text-[12px] font-medium underline underline-offset-[3px] transition-colors duration-150 ease-out hover:text-accent"
  >
    ver todas as fotos →
  </button>
</section>
