---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { ctaHref } from '../lib/site';
---

<a
  href={ctaHref}
  target="_blank"
  rel="noopener"
  data-analytics="whatsapp-bar"
  class="sticky bottom-0 z-20 flex min-h-[44px] transition-colors duration-150 ease-out lg:fixed lg:right-8 lg:bottom-8 lg:rounded-full lg:px-7 lg:shadow-[0_10px_30px_rgb(22_19_15/0.3)] lg:hover:bg-[#1fbe5b] items-center justify-center gap-[10px] bg-whatsapp px-[18px] py-[15px] text-[16px] font-semibold text-whatsapp-ink"
>
  <WhatsAppIcon class="size-[18px]" />
  Falar agora no WhatsApp
</a>
