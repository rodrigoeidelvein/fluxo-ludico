---
import Photo from './Photo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { ctaHref } from '../lib/site';
---

<section class="bg-yellow px-[18px] pt-[28px]">
  <h1 class="font-display text-h1 tracking-[-0.035em] uppercase">
    Festa de<br />criança<br />é trabalho<br />nosso.
  </h1>

  <p class="mt-4 max-w-[34ch] text-lead font-medium">
    Recreadores, pintura facial, esculturas de balão e workshop de malabarismo. Você cuida dos
    convidados, a gente cuida das crianças.
  </p>

  <a
    href={ctaHref}
    target="_blank"
    rel="noopener"
    data-analytics="whatsapp-hero"
    class="mt-5 flex min-h-[44px] items-center justify-center gap-[10px] rounded-control bg-ink px-[18px] py-4 text-[16px] font-semibold text-paper transition-colors duration-150 ease-out hover:bg-black"
  >
    <WhatsAppIcon class="size-[18px] text-whatsapp" />
    Chamar no WhatsApp
  </a>

  <Photo
    alt="Recreador da Fluxo Lúdico brincando com um grupo de crianças em uma festa"
    tint="tint-yellow"
    caption="foto — recreador com grupo de crianças"
    class="mt-[22px] h-[220px]"
  />
</section>
